{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Agent Traffic Light",
  "version": "0.1.0",
  "identifier": "com.cursor.agent-traffic-light",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Traffic Light",
        "width": 140,
        "height": 36,
        "minWidth": 140,
        "minHeight": 36,
        "resizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": false,
        "x": 48,
        "y": 120
      },
      {
        "label": "settings",
        "title": "设置",
        "width": 360,
        "height": 780,
        "minWidth": 360,
        "minHeight": 780,
        "resizable": false,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "visible": false,
        "center": true
      },
      {
        "label": "menu",
        "title": "菜单",
        "width": 120,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "toast",
        "title": "灯状态",
        "width": 220,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
